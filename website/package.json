{
  "name": "@shoehive/website",
  "private": true,
  "description": "The Shoehive documentation site (Astro Starlight), deployed to shoehive.jtay.co.uk.",
  "type": "module",
  "scripts": {
    "sync": "tsx scripts/sync-docs.ts",
    "dev": "pnpm sync && astro dev",
    "build": "pnpm sync && astro build",
    "preview": "astro preview",
    "typecheck": "tsc -p tsconfig.json && tsc -p snippets/tsconfig.json",
    "check": "pnpm check:dashes && pnpm check:generated && pnpm check:snippets",
    "check:snippets": "tsx scripts/check-snippets.ts",
    "check:dashes": "tsx scripts/check-dashes.ts",
    "check:generated": "tsx scripts/sync-docs.ts --check",
    "check:dist": "tsx scripts/check-links.ts && tsx scripts/check-dashes.ts --dist",
    "todo": "tsx scripts/list-todo.ts"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.3.5",
    "@astrojs/markdown-satteri": "0.4.6",
    "@astrojs/starlight": "0.42.8",
    "astro": "7.4.4",
    "starlight-typedoc": "0.23.2",
    "typedoc": "0.28.20",
    "typedoc-plugin-markdown": "4.14.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "ioredis": "^6.0.0",
    "react": "^19.3.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "zod": "^4.6.7"
  }
}
